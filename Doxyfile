PROJECT_NAME = "Adafruit LT8912B"
PROJECT_BRIEF = "Arduino LT8912B bridge control and ESP32-P4 DSI display"
INPUT = src README.md
FILE_PATTERNS = *.h *.cpp *.md
RECURSIVE = YES
USE_MDFILE_AS_MAINPAGE = README.md
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
QUIET = YES
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = YES
ENABLE_PREPROCESSING = YES
PREDEFINED = ARDUINO_ARCH_ESP32=1 CONFIG_IDF_TARGET_ESP32P4=1
GENERATE_HTML = YES
HTML_OUTPUT = html
GENERATE_LATEX = NO
